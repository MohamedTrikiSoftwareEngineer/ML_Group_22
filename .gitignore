# ---- Python ----
__pycache__/
*.pyc
.ipynb_checkpoints/

# ---- Environments (never commit the bundled venv) ----
.venv/
ml_env/
.env

# ---- Local dev scratch (not part of the deliverable) ----
.dev/
CHANGELOG.md

# ---- Data ----
# Track ONLY the four supplied input files; ignore every generated artifact
# (pickles, *_raw/*_clean csv, predictions, and the features/figures/logs/metrics subfolders).
data/*
!data/.gitkeep
!data/train.csv
!data/test.csv
!data/clientes.csv
!data/sample_submission.csv

# ---- Artifacts (regenerable outputs: metrics, figures, logs, feature lists) ----
# The notebooks cannot create folders (Path.mkdir is not in the course toolkit),
# so the folder skeleton is committed via .gitkeep and only the contents are ignored.
# This guarantees the directories exist on a fresh clone -> no FileNotFoundError.
artifacts/**
!artifacts/**/
!artifacts/**/.gitkeep

# ---- Deliverables ----
# Committed: the 2-page PDF (task 5) and the Kaggle submission CSV (task 4).
# PLAYBOOK.html is a private study/walkthrough document, not a graded deliverable,
# and it links into artifacts/figures which are not committed - so it stays local.
deliverables/PLAYBOOK.html
*.zip

# ---- LaTeX build by-products ----
# report/ tracks only the .tex source; the graded PDF is the copy under deliverables/,
# and report/figures/ is a staging folder for PNGs the notebooks already write.
report/*.pdf
report/*.aux
report/*.log
report/*.out
report/figures/
